+// Public resource references use the low sixteen bits, independently of the
+// device's internal references. Acquiring a surface with no public owners also
+// acquires its parent texture, as D3DResource_AddRef does.
+void AddPublicRef(uint32_t resource) {
+    if (!resource) return;
+    const uint32_t common = R32(resource);
+    if (!(common & 0xFFFF) && (common & 0x70000) == 0x50000)
+        AddPublicRef(R32(resource + 0x14));
+    W32(resource, R32(resource) + 1);
+}
